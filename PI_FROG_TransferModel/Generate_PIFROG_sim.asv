% Solves normalized NLS equation with split-step method
% Modifed Raman response function (2006 OL paper) 

% close all; tic; 
clear all;
%---Specify input parameters
T0 = 50;          % pulse width in fs
lam0 = 835;       % in nmC:\Users\ECEE1B79\OneDrive - UCB-O365\G\Publications\In progress\2024 - MultiDomain-PINN for forward problems in ultrafast nonlinear photonics
s = lam0/(2*pi*3e2*T0)*0;  % self-steepening
RamOn = 0;

distance = pi/2;   % normalized to dispersion length
N = 2;          % soliton order
sbeta2 = -1;    % sign of beta_2 (positive is normal negative is anomolous)
mshape = 0;     % 0 for sech, m>0 for super-Gaussian
delta3= 0.00;   % beta3/16*T0*abs(beta2))
delta4 = 0.0;   % beta4/(24*T0^2*abs(beta2))
%delta5=0; delta6=0; delta7=0; delta8=0;
chirp0 = 0;     % input pulse chirp (default value)

%---set silumation parameters
nt = 2^10;
Tmax = 6;       % FFT points and window size
% step_num = 99500*2*0 + 100000;   %round(40*distance*N^2); 
zstep = 200;      % no of z steps
step_num = zstep*100;
ng = step_num/zstep;        % store data for 3D.
deltaz = distance/step_num; % step size in z
dtau = (2*Tmax)/nt;         % step size in tau 

%-------tau and omega arrays
tau = (-nt/2:nt/2-1)*dtau;  % temporal grid
omega = fftshift((pi/Tmax)*(-nt/2:nt/2-1));  % freq array

% Defination of Raman response function
if RamOn>0
fR = 0.245;  fb=0.21;
tau1=12.2/T0; tau2=32/T0; tau_b=96/T0;
h = (1-fb)*(tau1^2 + tau2^2)/(tau1*tau2^2)*exp(-tau/tau2).*sin(tau/tau1)...
        +fb*((2*tau_b-tau)/tau_b^2).*exp(-tau/tau_b);
h(1:nt/2) = 0;      % causality

else
   h = zeros(1,nt); fR=0; 
end
Ram_res = h;
%---Input Field profile
if mshape==0
    uu = sech(tau).*exp(-1i*chirp0*tau.^2);     %soliton
else
    uu = exp(-0.5*(1+1i*chirp0).*tau.^(2*mshape)); %super-Gaussian
end

%-----Input 3D data   
  uu_3d(1,:)=uu.*conj(uu); % Intensity in time domain
  u_3d(1,:) = real(uu);
  v_3d(1,:) = imag(uu);
  temp = fftshift(ifft(uu));
  spect_3d(1,:)=abs(temp).^2; % spectrum au unit

%----store dispersive phase shifts to speedup code
dispersion = exp(1i*deltaz*(0.5*sbeta2*omega.^2 +...
    delta3*omega.^3 + delta4*omega.^4));
hhz = 1i*N^2*deltaz;
  
%*********[ Beginning of MAIN Loop]***********
% scheme: 1/2N -> D -> 1/2N; first half step nonlinear
P=uu.*conj(uu);
  convl=(nt*dtau)*fft(ifft(ifftshift(h)).*ifft(ifftshift(P))); % Convolution of raman response with Power (Intensity) normalized to windowing 
  convl=fftshift(convl); 
%   sst3=deriv1(convl,dtau);% Take derivative of convolution wrt to time 
%   sstnew=1i*s*fR*(sst3 + (conj(uu).*convl)./(P+eps).*sst2); % Adjust sst with this value?
  temp = uu.*exp(((1-fR)*(abs(uu).^2)+ fR*convl).*hhz/2); % Apply full step on nonlinearity
  tic
for n=1:step_num
  f_temp = ifft(temp).*dispersion; % 1 full step hhz of dispersion    
  uu = fft(f_temp); % uu is in t domain
  P=uu.*conj(uu);
  convl=(nt*dtau)*fft(ifft(ifftshift(h)).*ifft(ifftshift(P))); % Convolution of raman response with Power (Intensity) normalized to windowing 
    convl=fftshift(convl);
  % Convolution terms based on JM math
  duu_dt = deriv1(uu,dtau);
  duuc_dt = deriv1(conj(uu),dtau);
  dconvl_dt = deriv1(convl,dtau);
  SST = (2*(1-fR)*1j*s*(duu_dt.*P + 1/2*(duuc_dt).*uu.*uu) + ...
      1j*s*fR*(duu_dt.*convl + dconvl_dt.*uu))./(uu+eps);
  
  temp = uu.*exp(((1-fR)*(abs(uu).^2)+ fR*convl + SST).*hhz); % Apply full step on nonlinearity
  spect=fftshift(ifft(temp));
      if mod(n,ng)==0
          u_3d(n/ng+1,:) = real(temp);
          v_3d(n/ng+1,:) = imag(temp);
          uu_3d((n/ng+1),:)=temp.*conj(temp); % temporal power
          spect_3d((n/ng+1),:)=spect.*conj(spect); % spectral power
      end
end
%***************[ End of MAIN Loop ]**************
uu_3d = real(uu_3d);
spect_3d = real(spect_3d);
%----Plot output pulse shape and spectrum 
colormap(1-jet)
z=linspace(0,distance,zstep+1); % normalised distance
subplot(1,2,1);
    h = sqrt(u_3d.^2+v_3d.^2);
    uu_3d = 10*log10(uu_3d); % convert to dB units
    pmax = max(max(uu_3d));       % maximum value
    pcolor(tau,z,uu_3d);          % 3D plot
    caxis([pmax-50, pmax]); xlim([-50,50]); shading interp;
    set(gca,'FontSize', 12); %title('(a)')
    xlabel('Time (t/T_0)'); ylabel('Distance (z/L_D)')

subplot(1,2,2)
    H = sqrt(spect_3d);
    spect_3d=10*log10(spect_3d); % convert to dB units
    freq = fftshift(omega/(2*pi)); % freq array
    pmax = max(max(spect_3d)); % max value for scaling plot
    pcolor(freq,z,spect_3d);
    caxis([pmax-50, pmax]); xlim([-4,4]); shading interp;
    set(gca,'FontSize', 12); %title('(a)')
    xlabel('(\nu-\nu_0)T_0'); %ylabel('Distance (z/L_D)')

figure(2);clf;
subplot(2,1,1)
plot(freq,H(end,:))
subplot(2,1,2)
plot(tau,h(end,:))
toc

figure(3);clf;
subplot(2,1,1);
plot(tau,v_3d(end,:));hold on; plot(tau,u_3d(end,:))
subplot(2,1,2);
plot(tau,v_3d(1,:));hold on; plot(tau,u_3d(1,:))


params.D = -sbeta2;
params.N2 = N^2;
params.Ram_res = Ram_res;
params.delta3 = delta3;
params.T0 = T0;
params.WinT = nt*dtau;
params.fR = fR;
params.s  = s;

data.u0 = u_3d(1,:);
data.v0 = v_3d(1,:);
data.h0 = data.u0 + 1j.*data.v0;
data.h  = h';
data.H  = H';
data.w  = freq.*2*pi;
data.t  = tau; 
data.z  = z;
data.v_sim = v_3d;
data.u_sim = u_3d;

figure(1);clf;
subplot(3,1,1)
    imagesc(u_3d'); colorbar
subplot(3,1,2)
    imagesc(v_3d'); colorbar
subplot(3,1,3)
    imagesc(h'); colorbar


fname = 'PI_FROG_SIM_v1.mat';
save(strcat('data/',fname),'data','params')f

fprintf('FILE SAVED IN data FOLDER AS: \n')
fprin
